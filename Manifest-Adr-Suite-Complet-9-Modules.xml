  <ProviderName>Banque de France - DRTI - DSCO - ADR</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="ADR Outlook Suite"/>
  <Description DefaultValue="Plateforme unique ADR Banque de France - Migration VSTO vers Web Add-ins - 9 modules : Hérisson, Mailing, Retour Mailing, Mes Archives, QuiEstCe, Absences, Syndicats, Déconnexion, Signature & Chiffrement. Compatible New Outlook, OWA, Desktop, Mobile. SSO Entra ID + FBI, hébergement Catalyse/Nginx, VIP intern-tlwrk-mobil-waccs"/>
  
  <!-- ICONES - URLs publiques HTTPS obligatoires pour Integrated Apps - Remplace par ton Nginx Catalyse -->
  <IconUrl DefaultValue="https://dellasiegaexternal2.github.io/adr-suite/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://dellasiegaexternal2.github.io/adr-suite/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://dellasiegaexternal2.github.io/adr-suite/support.html"/>

  <AppDomains>
    <AppDomain>https://dellasiegaexternal2.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://login.microsoft.com</AppDomain>
  </AppDomains>

  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.8"/></Sets></Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://dellasiegaexternal2.github.io/adr-suite/taskpane.html"/>
        <RequestedHeight>650</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>

