                    <Item id="Deconnexion.Compose"><Label resid="Deconnexion.Label"/><Supertip><Title resid="Deconnexion.Label"/><Description resid="Deconnexion.Tooltip"/></Supertip><Icon><bt:Image size="16" resid="Icon.Deconnexion.16"/><bt:Image size="32" resid="Icon.Deconnexion.32"/><bt:Image size="80" resid="Icon.Deconnexion.80"/></Icon><Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url.Deconnexion"/></Action></Item>
