    <!-- SSO Entra ID + FBI - App Registration BDF-M365-WebAddins-Platform -->
    <WebApplicationInfo>
      <Id>e92a8324-40d8-4ce5-876d-99df6b07acf9</Id>
      <Resource>api://dellasiegaexternal2.github.io/e92a8324-40d8-4ce5-876d-99df6b07acf9</Resource>
      <Scopes>
        <Scope>openid</Scope><Scope>profile</Scope><Scope>email</Scope>
        <Scope>User.Read</Scope><Scope>User.Read.All</Scope>
        <Scope>People.Read.All</Scope><Scope>Presence.Read.All</Scope>
        <Scope>Mail.Read</Scope><Scope>Mail.ReadWrite</Scope><Scope>Mail.Send</Scope>
        <Scope>Calendars.Read</Scope><Scope>Calendars.Read.Shared</Scope>
        <Scope>Group.Read.All</Scope><Scope>Directory.Read.All</Scope>
        <Scope>Places.Read.All</Scope>
      </Scopes>
    </WebApplicationInfo>

    <Requirements><bt:Sets DefaultMinVersion="1.8"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>

