          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="ADR.Group.Read">
                <Label resid="ADR.Group.Label"/>
                <Control xsi:type="Menu" id="ADR.Menu.Read">
                  <Label resid="ADR.Menu.Label"/>
                  <Supertip><Title resid="ADR.Menu.Label"/><Description resid="ADR.Menu.Tooltip"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.16x16"/><bt:Image size="32" resid="Icon.32x32"/><bt:Image size="80" resid="Icon.80x80"/></Icon>
                  <Items>
                    <Item id="Herisson.Read"><Label resid="Herisson.Label"/><Supertip><Title resid="Herisson.Label"/><Description resid="Herisson.Tooltip"/></Supertip><Icon><bt:Image size="16" resid="Icon.Herisson.16"/><bt:Image size="32" resid="Icon.Herisson.32"/><bt:Image size="80" resid="Icon.Herisson.80"/></Icon><Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url.Herisson"/></Action></Item>
                    <Item id="QuiEstCe.Read"><Label resid="QuiEstCe.Label"/><Supertip><Title resid="QuiEstCe.Label"/><Description resid="QuiEstCe.Tooltip"/></Supertip><Icon><bt:Image size="16" resid="Icon.QuiEstCe.16"/><bt:Image size="32" resid="Icon.QuiEstCe.32"/><bt:Image size="80" resid="Icon.QuiEstCe.80"/></Icon><Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url.QuiEstCe"/></Action></Item>
